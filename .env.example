# Copy to .env or configure in CI/Secrets Manager for release builds.
# Do NOT commit real credentials or keystore passwords to version control.
# Note: Public streaming and lyrics providers (JioSaavn, Piped, Invidious, Audius,
# NewPipeExtractor, and LRCLIB) are keyless and require no API keys.

# Android Release Signing (read by app/build.gradle.kts via environment / Gradle properties)
RELEASE_STORE_FILE=path/to/your-release-keystore.jks
RELEASE_STORE_PASSWORD=your_keystore_password_here
RELEASE_KEY_ALIAS=your_key_alias_here
RELEASE_KEY_PASSWORD=your_key_password_here
